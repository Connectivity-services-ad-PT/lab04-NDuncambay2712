{
  "name": "fit4110-lab02-openapi-contract",
  "version": "1.0.0",
  "private": true,
  "description": "FIT4110 Lab 02 OpenAPI 3.1 contract-first student repository",
  "scripts": {
    "check": "node --version && npm --version",
    "install:cli": "npm install -g @stoplight/spectral-cli@6.11.1 @stoplight/prism-cli@5.14.2",
    "start": "node server.js",
    "lint": "spectral lint contracts/notification.openapi.yaml --ruleset campus-spectral.yaml",
    "lint:contract": "spectral lint contracts/notification.openapi.yaml --ruleset campus-spectral.yaml",
    "lint:report": "mkdir -p reports && spectral lint contracts/notification.openapi.yaml --ruleset campus-spectral.yaml --format text > reports/spectral-lint.log",
    "mock": "prism mock contracts/notification.openapi.yaml --port 4010",
    "mock:notification": "prism mock contracts/notification.openapi.yaml --port 4010",
    "test:mock:curl": "bash scripts/test_mock_with_curl.sh",
    "test:mock": "node scripts/test-runner.js mock",
    "test:local": "node scripts/test-runner.js local",
    "test": "node scripts/test-runner.js all"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.11.1",
    "newman": "^6.1.3",
    "newman-reporter-html": "^1.0.5",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
